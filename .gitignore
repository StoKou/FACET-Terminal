# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/website/
**/.venv/
**/.uv-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage
.pytest_cache/

# next.js
**/.next/
**/.vinext/
**/out/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!facet/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
**/dist/
**/.wrangler/
/outputs/
/work/

# FACET runtime data and generated artifacts
/facet/configs/local/
/facet/runs/
/facet/artifacts/
/facet/checkpoints/
/facet/logs/
/facet/reports/
/facet/final/
